{
"manifest_version": 3,
"name": "AirTok",
"version": "1.0",
"permissions": ["activeTab", "scripting", "webRequest"],
"host_permissions": ["https://www.tiktok.com/*"],
"action": {
"default_popup": "popup.html"
},
"content_scripts": [
{
"matches": ["https://www.tiktok.com/*"],
"js": ["dist/main.js"]
}
]
}